<?xml version="1.0" encoding="utf-8"?>
<!--
  GitHub build only (the Google Play build has no storage permission).
  Earlier GitHub versions asked for all-files access and saved some layers by
  their file path; keeping these declared means people who granted it keep it
  after updating, so those layers still open. The app no longer asks for it:
  picked files are read in place or copied in, as on Google Play.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="29"/>
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="29"/>
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE"
        tools:ignore="ScopedStorage"/>
</manifest>
