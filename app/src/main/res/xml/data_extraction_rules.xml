<?xml version="1.0" encoding="utf-8"?>
<!--
  Waypoints, layer state and settings are device-local, and imported chart
  files can be very large, so nothing is included in cloud backup or in a
  device-to-device transfer. Re-import charts on the new device.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
