<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <org.maplibre.android.maps.MapView
        android:id="@+id/mapView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Top bar: menu, live coordinates and the tool buttons -->
    <LinearLayout
        android:id="@+id/topBar"
        android:clickable="true"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#E60A0F1E"
        android:elevation="4dp"
        android:orientation="vertical">

        <View
            android:id="@+id/statusBarSpacer"
            android:layout_width="match_parent"
            android:layout_height="0dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="4dp"
            android:paddingEnd="8dp">

            <ImageButton
                android:id="@+id/btnMenu"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/cd_layers"
                android:src="@drawable/ic_menu"
                app:tint="@color/teal" />

            <TextView
                android:id="@+id/tvCoords"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/bg_top_coord"
                android:fontFamily="monospace"
                android:paddingStart="10dp"
                android:paddingTop="6dp"
                android:paddingEnd="10dp"
                android:paddingBottom="6dp"
                android:textColor="@color/teal"
                android:textSize="13sp" />

            <ImageButton
                android:id="@+id/btnGps"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginEnd="2dp"
                android:background="@drawable/bg_top_tool"
                android:contentDescription="@string/cd_gps"
                android:src="@drawable/ic_gps"
                app:tint="@color/text_primary" />

            <ImageButton
                android:id="@+id/btnWpt"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginEnd="2dp"
                android:background="@drawable/bg_top_tool"
                android:contentDescription="@string/cd_waypoint"
                android:src="@drawable/ic_waypoint_x"
                app:tint="@color/text_primary" />

            <ImageButton
                android:id="@+id/btnRoute"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginEnd="2dp"
                android:background="@drawable/bg_top_tool"
                android:contentDescription="@string/cd_route"
                android:src="@drawable/ic_route"
                app:tint="@color/text_primary" />

            <ImageButton
                android:id="@+id/btnMeasure"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_top_tool"
                android:contentDescription="@string/cd_measure"
                android:src="@drawable/ic_measure_ruler"
                app:tint="@color/text_primary" />
        </LinearLayout>
    </LinearLayout>

    <!-- Centre crosshair and the depth readout beneath it -->
    <FrameLayout
        android:id="@+id/crosshairContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clickable="false"
        android:focusable="false">

        <TextView
            android:id="@+id/crosshairDot"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_gravity="center"
            android:alpha="0.95"
            android:gravity="center"
            android:text="@string/crosshair_glyph"
            android:textColor="@color/teal"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/tvCrosshairDepth"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:background="#AA0A0F1E"
            android:fontFamily="monospace"
            android:padding="5dp"
            android:textColor="@color/text_primary"
            android:textSize="13sp"
            android:translationY="28dp"
            android:visibility="gone" />
    </FrameLayout>

    <TextView
        android:id="@+id/tvHint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginBottom="96dp"
        android:background="@drawable/bg_hint_bar"
        android:elevation="3dp"
        android:fontFamily="sans-serif"
        android:gravity="center"
        android:padding="7dp"
        android:textColor="@color/text_primary"
        android:textSize="13sp"
        android:visibility="gone" />

    <!-- Route planner readout -->
    <LinearLayout
        android:id="@+id/routeCard"
        android:clickable="true"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="#FF111827"
        android:elevation="4dp"
        android:orientation="vertical"
        android:padding="12dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="sans-serif-medium"
                android:text="@string/route_label"
                android:textColor="@color/teal"
                android:textSize="11sp"
                tools:ignore="SmallSp" />

            <Button
                android:id="@+id/btnRouteUndo"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:layout_marginEnd="6dp"
                android:background="@drawable/bg_secondary_button"
                android:paddingHorizontal="12dp"
                android:text="@string/action_undo"
                android:textColor="@color/teal"
                android:textSize="11sp" />

            <Button
                android:id="@+id/btnRouteClear"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:layout_marginEnd="6dp"
                android:background="@drawable/bg_secondary_button"
                android:paddingHorizontal="12dp"
                android:text="@string/action_clear"
                android:textColor="@color/text_muted"
                android:textSize="11sp" />

            <ImageButton
                android:id="@+id/btnRouteGpx"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="@drawable/bg_secondary_button"
                android:contentDescription="@string/cd_export_gpx"
                android:src="@drawable/ic_gpx"
                app:tint="@color/teal" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvRouteInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif"
            android:textColor="@color/text_primary"
            android:textSize="12sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnRouteSave"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_marginEnd="5dp"
                android:layout_weight="1"
                android:background="@drawable/bg_secondary_button"
                android:paddingHorizontal="2dp"
                android:text="@string/action_route_save"
                android:textColor="@color/teal"
                android:textSize="11sp" />

            <Button
                android:id="@+id/btnRouteLibrary"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_marginEnd="5dp"
                android:layout_weight="1"
                android:background="@drawable/bg_secondary_button"
                android:paddingHorizontal="2dp"
                android:text="@string/action_route_library"
                android:textColor="@color/teal"
                android:textSize="11sp" />

            <Button
                android:id="@+id/btnRouteLegs"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_marginEnd="5dp"
                android:layout_weight="1"
                android:background="@drawable/bg_secondary_button"
                android:paddingHorizontal="2dp"
                android:text="@string/action_route_legs"
                android:textColor="@color/teal"
                android:textSize="11sp" />

            <Button
                android:id="@+id/btnRouteReverse"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_marginEnd="5dp"
                android:layout_weight="1"
                android:background="@drawable/bg_secondary_button"
                android:paddingHorizontal="2dp"
                android:text="@string/action_route_reverse"
                android:textColor="@color/teal"
                android:textSize="11sp" />

            <Button
                android:id="@+id/btnRouteGo"
                android:layout_width="0dp"
                android:layout_height="36dp"
                                android:layout_weight="1"
                android:background="@drawable/bg_primary_button"
                android:paddingHorizontal="2dp"
                android:text="@string/action_route_go"
                android:textColor="@color/navy"
                android:textSize="11sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnSpeedSourceGps"
                android:layout_width="wrap_content"
                android:layout_height="30dp"
                android:layout_marginEnd="6dp"
                android:background="@drawable/bg_secondary_button"
                android:contentDescription="@string/cd_speed_source_gps"
                android:paddingHorizontal="10dp"
                android:text="@string/action_speed_source_gps"
                android:textColor="@color/text_muted"
                android:textSize="10sp" />

            <Button
                android:id="@+id/btnSpeedSourceCustom"
                android:layout_width="wrap_content"
                android:layout_height="30dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_primary_button"
                android:contentDescription="@string/cd_speed_source_custom"
                android:paddingHorizontal="10dp"
                android:text="@string/action_speed_source_custom"
                android:textColor="@color/navy"
                android:textSize="10sp" />

            <EditText
                android:id="@+id/etCustomSpeed"
                android:layout_width="70dp"
                android:layout_height="30dp"
                android:background="@drawable/bg_secondary_button"
                android:contentDescription="@string/cd_custom_speed"
                android:gravity="center"
                android:hint="@string/hint_custom_speed"
                android:imeOptions="actionDone"
                android:inputType="numberDecimal"
                android:paddingHorizontal="6dp"
                android:singleLine="true"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_muted"
                android:textSize="12sp" />
        </LinearLayout>

        <View
            android:id="@+id/navBarSpacer"
            android:layout_width="match_parent"
            android:layout_height="0dp" />
    </LinearLayout>

    <!-- Measurement readout -->
    <LinearLayout
        android:id="@+id/measureCard"
        android:clickable="true"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="#FF111827"
        android:elevation="4dp"
        android:orientation="vertical"
        android:padding="12dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvMeasure"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="sans-serif"
                android:textColor="@color/text_primary"
                android:textSize="13sp" />

            <Button
                android:id="@+id/btnMeasureClear"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:background="@drawable/bg_secondary_button"
                android:paddingHorizontal="12dp"
                android:text="@string/action_clear"
                android:textColor="@color/teal"
                android:textSize="11sp" />
        </LinearLayout>

        <View
            android:id="@+id/measureNavSpacer"
            android:layout_width="match_parent"
            android:layout_height="0dp" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvMapAttribution"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|start"
        android:layout_marginStart="8dp"
        android:layout_marginBottom="72dp"
        android:background="#AA0A0F1E"
        android:paddingStart="6dp"
        android:paddingTop="3dp"
        android:paddingEnd="6dp"
        android:paddingBottom="3dp"
        android:textColor="@color/text_muted"
        android:textSize="9sp"
        android:visibility="gone"
        tools:ignore="SmallSp" />

    <FrameLayout
        android:id="@+id/panelScrim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#88000000"
        android:visibility="gone" />

    <!-- Side panel: layer stack, imports and waypoints -->
    <LinearLayout
        android:id="@+id/sidePanel"
        android:clickable="true"
        android:layout_width="300dp"
        android:layout_height="match_parent"
        android:background="@color/panel"
        android:elevation="8dp"
        android:orientation="vertical"
        android:translationX="-300dp">

        <View
            android:id="@+id/panelStatusSpacer"
            android:layout_width="match_parent"
            android:layout_height="0dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:background="@color/navy"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingEnd="8dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="sans-serif-medium"
                android:text="@string/panel_title"
                android:textColor="@color/teal"
                android:textSize="13sp" />

            <ImageButton
                android:id="@+id/btnPanelClose"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/cd_close"
                android:src="@drawable/ic_close" />
        </LinearLayout>

        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingBottom="32dp">

                <Button
                    android:id="@+id/btnSettings"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginHorizontal="16dp"
                    android:layout_marginTop="14dp"
                    android:background="@drawable/bg_setting_row"
                    android:drawableEnd="@drawable/ic_chevron_right"
                    android:drawableTint="@color/text_muted"
                    android:gravity="center_vertical|start"
                    android:paddingStart="16dp"
                    android:paddingEnd="12dp"
                    android:text="@string/action_settings"
                    android:textAllCaps="false"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:paddingStart="16dp"
                    android:paddingTop="16dp"
                    android:paddingEnd="16dp"
                    android:paddingBottom="6dp"
                    android:text="@string/section_map_layers"
                    android:textColor="@color/text_muted"
                    android:textSize="10sp"
                    tools:ignore="SmallSp" />

                <LinearLayout
                    android:id="@+id/layersList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="12dp"
                    android:paddingTop="4dp"
                    android:paddingEnd="12dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:paddingStart="16dp"
                    android:paddingTop="16dp"
                    android:paddingEnd="16dp"
                    android:paddingBottom="6dp"
                    android:text="@string/section_waypoints"
                    android:textColor="@color/text_muted"
                    android:textSize="10sp"
                    tools:ignore="SmallSp" />

                <LinearLayout
                    android:id="@+id/waypointsList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/navy"
            android:orientation="vertical"
            android:padding="12dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:paddingBottom="6dp"
                android:text="@string/section_basemap"
                android:textColor="@color/text_muted"
                android:textSize="10sp"
                tools:ignore="SmallSp" />

            <Spinner
                android:id="@+id/spinBasemap"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/bg_spinner_field"
                android:paddingStart="12dp"
                android:paddingEnd="8dp" />
        </LinearLayout>
    </LinearLayout>

    <!-- New waypoint sheet -->
    <FrameLayout
        android:id="@+id/wptDialogBg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#BB000000"
        android:elevation="10dp"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/wptDialog"
            android:clickable="true"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="10dp"
            android:layout_marginBottom="10dp"
            android:background="@drawable/bg_dialog_surface"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="22dp"
            android:paddingEnd="20dp"
            android:paddingBottom="18dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="14dp"
                android:fontFamily="sans-serif-medium"
                android:text="@string/wpt_dialog_title"
                android:textColor="@color/teal"
                android:textSize="12sp" />

            <EditText
                android:id="@+id/etWptName"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginBottom="14dp"
                android:autofillHints="name"
                android:background="@drawable/bg_input_field"
                android:hint="@string/wpt_name_hint"
                android:imeOptions="actionDone"
                android:inputType="text"
                android:maxLines="1"
                android:padding="12dp"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_muted" />

            <EditText
                android:id="@+id/etWptDesc"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="14dp"
                android:autofillHints="postalAddress"
                android:background="@drawable/bg_input_field"
                android:hint="@string/wpt_desc_hint"
                android:inputType="textMultiLine"
                android:maxLines="3"
                android:minLines="2"
                android:padding="12dp"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_muted" />

            <LinearLayout
                android:id="@+id/colorPicker"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:gravity="center"
                android:orientation="horizontal">

                <View
                    android:id="@+id/col0"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_margin="5dp"
                    android:background="@drawable/col_red" />

                <View
                    android:id="@+id/col1"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_margin="5dp"
                    android:background="@drawable/col_orange" />

                <View
                    android:id="@+id/col2"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_margin="5dp"
                    android:background="@drawable/col_yellow" />

                <View
                    android:id="@+id/col3"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_margin="5dp"
                    android:background="@drawable/col_green" />

                <View
                    android:id="@+id/col4"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_margin="5dp"
                    android:background="@drawable/col_blue" />

                <View
                    android:id="@+id/col5"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_margin="5dp"
                    android:background="@drawable/col_purple" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/iconPicker"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:gravity="center"
                android:orientation="horizontal" />

            <TextView
                android:id="@+id/tvWptCoords"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="14dp"
                android:background="@drawable/bg_setting_row"
                android:fontFamily="monospace"
                android:gravity="center_vertical"
                android:minHeight="48dp"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:text="@string/placeholder_dash"
                android:textColor="@color/text_primary"
                android:textSize="12sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:orientation="horizontal"
                tools:ignore="ButtonStyle">

                <Button
                    android:id="@+id/btnWptCancel"
                    android:layout_width="wrap_content"
                    android:layout_height="44dp"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/bg_secondary_button"
                    android:paddingHorizontal="16dp"
                    android:text="@string/action_cancel"
                    android:textAllCaps="false"
                    android:textColor="@color/text_primary" />

                <Button
                    android:id="@+id/btnWptSave"
                    android:layout_width="wrap_content"
                    android:layout_height="44dp"
                    android:background="@drawable/bg_primary_button"
                    android:paddingHorizontal="24dp"
                    android:text="@string/action_save_waypoint"
                    android:textAllCaps="false"
                    android:textColor="@color/navy" />
            </LinearLayout>

            <View
                android:id="@+id/wptNavSpacer"
                android:layout_width="match_parent"
                android:layout_height="0dp" />
        </LinearLayout>
    </FrameLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
